#!/usr/bin/env python3
from __future__ import annotations

import os
import sys
from pathlib import Path


SKILL_NAME = "fami-claw-skill"
VALUE_OPTIONS = {
    "--home",
    "--env-file",
    "--device-ip",
    "--device-mac",
    "--broadcast-ip",
    "--port",
    "--timeout",
}
COMMAND_ALIASES = {
    "read-temp": "get-temp",
    "read-temperature": "get-temp",
    "water-temp": "get-temp",
    "water-temperature": "get-temp",
    "temp": "get-temp",
    "temperature": "get-temp",
    "status": "get-temp",
    "read-gas": "get-total-gas",
    "read-total-gas": "get-total-gas",
    "remaining-gas": "get-total-gas",
    "remaining-gas-amount": "get-total-gas",
    "total-gas": "get-total-gas",
    "gas": "get-total-gas",
    "gas-status": "get-total-gas",
    "usage": "get-total-gas",
    "set-temperature": "set-temp",
    "threshold-check": "check-threshold",
}


def iter_candidate_homes(wrapper_path: Path) -> list[Path]:
    candidates: list[Path] = []
    env_home = os.environ.get("FAMICLEAN_HOME")
    if env_home:
        candidates.append(Path(env_home).expanduser())
    candidates.append(wrapper_path.resolve().parent.parent.parent)
    candidates.append(Path.home() / "custom-claw-tools" / "famiclean-skill")
    candidates.append(Path("/home/haman/custom-claw-tools/famiclean-skill"))
    return candidates


def resolve_runtime(wrapper_path: Path) -> tuple[Path, Path]:
    seen: set[Path] = set()
    for home in iter_candidate_homes(wrapper_path):
        home = home.resolve()
        if home in seen:
            continue
        seen.add(home)
        cli_path = home / "skills" / SKILL_NAME / "scripts" / "famiclean.py"
        if cli_path.is_file():
            return home, cli_path
    raise SystemExit(
        "Unable to locate famiclean.py. Set FAMICLEAN_HOME or install the project "
        "under either ~/custom-claw-tools/famiclean-skill or /home/haman/custom-claw-tools/famiclean-skill."
    )


def find_command_index(args: list[str]) -> int | None:
    index = 0
    while index < len(args):
        token = args[index]
        if token in VALUE_OPTIONS:
            index += 2
            continue
        if token.startswith("-"):
            index += 1
            continue
        return index
    return None


def normalize_args(raw_args: list[str]) -> list[str]:
    if not raw_args or raw_args[0] in {"-h", "--help", "help"}:
        return ["--help"]

    args = [arg for arg in raw_args if arg != "--json"]
    command_index = find_command_index(args)
    if command_index is None:
        return ["--help"]

    args[command_index] = COMMAND_ALIASES.get(args[command_index], args[command_index])
    args.insert(command_index, "--json")
    return args


def iter_candidate_env_files() -> list[Path]:
    candidates: list[Path] = []
    env_file = os.environ.get("FAMICLEAN_ENV_FILE")
    if env_file:
        candidates.append(Path(env_file).expanduser())
    candidates.append(Path.home() / ".config" / "fami-ghome-live" / ".env")
    candidates.append(Path("/home/appuser/.config/fami-ghome-live/.env"))
    candidates.append(Path("/home/haman/.config/fami-ghome-live/.env"))
    return candidates


def resolve_default_env_file() -> Path | None:
    seen: set[Path] = set()
    for candidate in iter_candidate_env_files():
        resolved = candidate.expanduser().resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        if resolved.is_file():
            return resolved
    return None


def apply_runtime_defaults(home: Path, args: list[str]) -> list[str]:
    resolved_args = list(args)
    if "--home" not in resolved_args:
        resolved_args = ["--home", str(home), *resolved_args]
    if "--env-file" not in resolved_args:
        default_env_file = resolve_default_env_file()
        if default_env_file is not None:
            resolved_args = ["--env-file", str(default_env_file), *resolved_args]
    return resolved_args


def main() -> int:
    home, cli_path = resolve_runtime(Path(__file__))
    forward_args = apply_runtime_defaults(home, normalize_args(sys.argv[1:]))
    os.execv(sys.executable, [sys.executable, str(cli_path), *forward_args])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
